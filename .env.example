# Copie para .env e preencha. O .env nunca vai para o repositório nem para o site.
# Só para o teste local (npm run abrir e npm run montar:teste). Não há servidor: no site publicado, cada pessoa cola as chaves na tela IAs (ficam cifradas no navegador).
# IAs 1, 2 e 3 (texto): Groq, console.groq.com/keys
GROQ_API_KEY=
# Reserva de emergência (texto e imagem): Google AI Studio, aistudio.google.com/apikey
GEMINI_API_KEY=
# Imagens das artes: Pollinations, enter.pollinations.ai/keys (chave secreta sk_...)
POLLINATIONS_API_KEY=
# Opcional (só montar:teste): chave da Places API (New) do Google para a tela Captar clientes
GOOGLE_PLACES_KEY=

# Cofre do site (para a IA funcionar em outros aparelhos): senha com 12+ caracteres. Com ela, o build (npm run montar e o GitHub Actions) põe as chaves acima CIFRADAS dentro do site; sem ela, o site sai sem cofre.
# No GitHub, cadastre COFRE_SENHA, GROQ_API_KEY (e as outras) em Settings > Secrets and variables > Actions.
COFRE_SENHA=
