# Copie para .env e preencha. O .env nunca vai para o repositório nem para o site.
# Só para o teste local (npm run abrir e npm run montar:teste). No Cloudflare, use os segredos com os mesmos nomes.
# IA 1 (criação e acompanhamento): OpenAI, platform.openai.com/api-keys
OPENAI_API_KEY=
# IA 2 (atendimento: briefing, resumo, orçamento e mensagem): Google AI Studio, aistudio.google.com/apikey
GEMINI_API_KEY=
# IA 3 (captação de clientes): Groq, console.groq.com/keys
GROQ_API_KEY=
# Opcional: chave da Places API (New) do Google para a tela Captar clientes
GOOGLE_PLACES_KEY=
