# Copie para .env e preencha. O .env nunca vai para o repositório nem para o site.
# Só para o build de teste local (npm run montar:teste):
GROQ_API_KEY=
# Opcional: chave da Places API (New) do Google para a tela Captar clientes no build de teste
GOOGLE_PLACES_KEY=
# Gemini (Google AI Studio): build de teste local; no Cloudflare use o segredo GEMINI_API_KEY
GEMINI_API_KEY=
